{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".output/**",
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_MAILPIT_URL"
      ]
    },
    "test:perf": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "test:db": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION"
      ]
    },
    "@sessionhub/web#test:db": {
      "dependsOn": [
        "@sessionhub/database#test:db"
      ],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION"
      ]
    },
    "@sessionhub/extension#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".output/**"
      ],
      "env": [
        "WXT_API_BASE_URL"
      ]
    },
    "@sessionhub/web#test:e2e": {
      "dependsOn": [
        "build",
        "@sessionhub/extension#test:e2e"
      ],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_MAILPIT_URL"
      ]
    }
  }
}
