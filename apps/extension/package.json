{
  "name": "@sessionhub/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @perf",
    "test:perf": "playwright test --grep @perf --reporter=list"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sessionhub/eslint-config": "workspace:*",
    "@sessionhub/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@sessionhub/contracts": "workspace:*",
    "@sessionhub/core": "workspace:*",
    "@sessionhub/ui": "workspace:*",
    "dexie": "4.4.6",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
