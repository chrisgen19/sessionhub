# Copy to .env.local (git-ignored). Never commit real secrets.
DATABASE_URL="postgresql://sessionhub:sessionhub_dev@127.0.0.1:54329/sessionhub"
# At least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Email (password reset, confirmation): disabled | mailpit | resend. `pnpm db:up` starts Mailpit;
# open http://127.0.0.1:58025 to read what the app sent.
MAIL_TRANSPORT="mailpit"
MAIL_FROM="SessionHub <no-reply@sessionhub.test>"
MAILPIT_URL="http://127.0.0.1:58025"
# Only for MAIL_TRANSPORT=resend.
RESEND_API_KEY=""
