{
  "extends": "@sessionhub/typescript-config/react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src", "test", "e2e-docker", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules"]
}
