# Copy to infra/docker/.env (git-ignored) for `docker compose -f infra/docker/compose.yaml up`.
# Use URL-safe characters for the password (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# Exact origin browsers use. Leave empty for http://localhost:<WEB_PORT>; set the public
# HTTPS origin when the app is served behind a proxy or on another host (production requires https://).
BETTER_AUTH_URL=
# Reverse proxies in front of the app: 1 for Coolify's Traefik, 2 with a CDN in front (docs/DEPLOYMENT.md).
TRUSTED_PROXY_COUNT=1
WEB_PORT=3030
# Email for password reset and confirmation: disabled | resend
MAIL_TRANSPORT=disabled
# e.g. SessionHub <no-reply@your-verified-domain.com>
MAIL_FROM=
RESEND_API_KEY=
