# Copy to infra/docker/.env (git-ignored) for `docker compose -f infra/docker/compose.yaml up`.
# Use URL-safe characters for the password (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3030
WEB_PORT=3030
