{
  "name": "@sessionhub/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test:db": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@sessionhub/eslint-config": "workspace:*",
    "@sessionhub/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "10.12.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "exports": {
    "./client": "./src/client.ts"
  }
}
