// SessionHub server schema (docs/DATA_MODEL.md section 3). Server-only: the extension
// never imports this package.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth core tables. Generated by the Better Auth CLI (`auth generate`, v1.7.9)
// for email/password on PostgreSQL. Keep them as generated so regeneration stays a
// clean diff; the only additions are back-relation fields on User (no new columns).
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // SessionHub relations (no columns on this table).
  devices           Device[]
  devicePairings    DevicePairing[]
  deviceCredentials DeviceCredential[]
  workspaces        Workspace[]
  savedSessions     SavedSession[]
  sessionVersions   SessionVersion[]
  syncClock         UserSyncClock?
  syncChanges       SyncChange[]
  receipts          SyncOperationReceipt[]
  settings          UserSettings?
  auditEvents       AuditEvent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// SessionHub domain. snake_case columns; app-level UUIDs (never browser runtime ids).
// Same-account ownership is enforced with composite foreign keys (id, user_id) where a
// row references another user-owned row.
// ---------------------------------------------------------------------------

/// A browser installation/profile. Revocation blocks API access; local data stays on the device.
model Device {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id")
  installationId        String    @map("installation_id") @db.Uuid
  displayName           String    @map("display_name") @db.VarChar(120)
  browser               String?   @db.VarChar(40)
  platform              String?   @db.VarChar(40)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt            DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)
  authCredentialVersion Int       @default(1) @map("auth_credential_version")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcedSessions  SavedSession[]
  authoredVersions SessionVersion[]
  receipts         SyncOperationReceipt[]
  credentials      DeviceCredential[]

  @@unique([userId, installationId])
  @@unique([id, userId])
  @@index([userId])
  @@map("devices")
}

/// One extension pairing request (RFC 8628-style device flow, docs/SECURITY_PRIVACY.md 5a).
/// Short-lived: pending for 10 minutes, redeemable once after approval.
model DevicePairing {
  id             String              @id @default(uuid()) @db.Uuid
  /// SHA-256 of the secret device code held only by the extension.
  deviceCodeHash String              @unique @map("device_code_hash") @db.Char(64)
  /// Short code the user compares on the approve page (no ambiguous characters).
  userCode       String              @unique @map("user_code") @db.VarChar(16)
  installationId String              @map("installation_id") @db.Uuid
  deviceName     String              @map("device_name") @db.VarChar(120)
  browser        String?             @db.VarChar(40)
  platform       String?             @db.VarChar(40)
  status         DevicePairingStatus @default(pending)
  /// Set on approval or denial: the account that decided.
  userId         String?             @map("user_id")
  /// Set on approval: the device row the credentials will belong to.
  deviceId       String?             @map("device_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(3)
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(3)
  lastPolledAt   DateTime?           @map("last_polled_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("device_pairings")
}

/// One issued access/refresh token pair. Rotation creates a new row and marks the old one
/// rotated; presenting a rotated refresh token (other than a lost-response retry) revokes the device.
model DeviceCredential {
  id                String    @id @default(uuid()) @db.Uuid
  deviceId          String    @map("device_id") @db.Uuid
  userId            String    @map("user_id")
  /// SHA-256 hashes only; the tokens themselves are never stored.
  accessTokenHash   String    @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  /// Device.authCredentialVersion at issue time; any later revoke or re-pair invalidates it.
  credentialVersion Int       @map("credential_version")
  accessExpiresAt   DateTime  @map("access_expires_at") @db.Timestamptz(3)
  refreshExpiresAt  DateTime  @map("refresh_expires_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// First successful use of either token (a rotated row whose successor was never used can be retried).
  usedAt            DateTime? @map("used_at") @db.Timestamptz(3)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  replacedById      String?   @map("replaced_by_id") @db.Uuid

  device Device @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([refreshExpiresAt])
  @@map("device_credentials")
}

model Workspace {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id")
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(1000)
  icon        String?   @db.VarChar(40)
  color       String?   @db.VarChar(20)
  position    Int       @default(0)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions SavedSession[]

  @@unique([id, userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("workspaces")
}

/// Canonical synced saved session. Window/group/tab rows hold the current structure;
/// SessionVersion holds immutable history.
model SavedSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id")
  workspaceId      String?   @map("workspace_id") @db.Uuid
  /// Provenance only, never a command target. Null for imported or migrated sessions.
  sourceDeviceId   String?   @map("source_device_id") @db.Uuid
  sourceDeviceName String    @default("") @map("source_device_name") @db.VarChar(120)
  name             String    @db.VarChar(200)
  description      String?   @db.VarChar(2000)
  isPinned         Boolean   @default(false) @map("is_pinned")
  isArchived       Boolean   @default(false) @map("is_archived")
  version          Int       @default(1)
  schemaVersion    Int       @default(1) @map("schema_version")
  /// Cached counts, maintained in the same transaction as child rows.
  tabCount         Int       @default(0) @map("tab_count")
  windowCount      Int       @default(0) @map("window_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  lastRestoredAt   DateTime? @map("last_restored_at") @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite keys keep the workspace and source device inside the same account.
  // NoAction: SetNull would also null user_id; workspace/device removal clears these in app code.
  workspace    Workspace?           @relation(fields: [workspaceId, userId], references: [id, userId], onDelete: NoAction)
  sourceDevice Device?              @relation(fields: [sourceDeviceId, userId], references: [id, userId], onDelete: NoAction)
  windows      SavedSessionWindow[]
  versions     SessionVersion[]

  @@unique([id, userId])
  @@index([userId, updatedAt(sort: Desc), id])
  @@index([userId, workspaceId, updatedAt(sort: Desc)])
  @@map("saved_sessions")
}

model SavedSessionWindow {
  id        String  @id @default(uuid()) @db.Uuid
  sessionId String  @map("session_id") @db.Uuid
  sortOrder Int     @map("sort_order")
  label     String? @db.VarChar(120)

  session SavedSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  groups  SavedSessionGroup[]
  tabs    SavedSessionTab[]

  @@unique([sessionId, sortOrder])
  @@map("saved_session_windows")
}

model SavedSessionGroup {
  id        String        @id @default(uuid()) @db.Uuid
  windowId  String        @map("window_id") @db.Uuid
  /// "title" matches the contracts DTO (DATA_MODEL.md calls it name).
  title     String        @default("") @db.VarChar(256)
  color     TabGroupColor @default(grey)
  collapsed Boolean       @default(false)
  sortOrder Int           @map("sort_order")

  window SavedSessionWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  tabs   SavedSessionTab[]

  @@unique([id, windowId])
  @@unique([windowId, sortOrder])
  @@map("saved_session_groups")
}

/// No favicon URL column: clients use the browser's local favicon cache instead.
model SavedSessionTab {
  id          String             @id @default(uuid()) @db.Uuid
  windowId    String             @map("window_id") @db.Uuid
  groupId     String?            @map("group_id") @db.Uuid
  title       String             @default("") @db.VarChar(1024)
  url         String             @db.VarChar(8192)
  pinned      Boolean            @default(false)
  sortOrder   Int                @map("sort_order")
  eligibility RestoreEligibility

  window SavedSessionWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  // Composite key: a tab can only belong to a group in its own window.
  group  SavedSessionGroup? @relation(fields: [groupId, windowId], references: [id, windowId], onDelete: NoAction)

  @@unique([windowId, sortOrder])
  @@map("saved_session_tabs")
}

/// Immutable revision of a saved session (normalized structure as validated JSON).
model SessionVersion {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  userId         String   @map("user_id")
  version        Int
  payload        Json
  checksum       String   @db.VarChar(128)
  authorDeviceId String?  @map("author_device_id") @db.Uuid
  operationId    String?  @map("operation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session      SavedSession @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorDevice Device?      @relation(fields: [authorDeviceId, userId], references: [id, userId], onDelete: NoAction)

  @@unique([sessionId, version])
  @@map("session_versions")
}

/// Per-user change sequence, advanced under a row lock with each accepted mutation.
model UserSyncClock {
  userId       String @id @map("user_id")
  lastSequence BigInt @default(0) @map("last_sequence")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sync_clocks")
}

/// Append-only, per-user ordered change log for incremental pull.
model SyncChange {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id")
  sequence      BigInt
  entityType    SyncEntityType @map("entity_type")
  entityId      String         @map("entity_id") @db.Uuid
  changeKind    SyncChangeKind @map("change_kind")
  entityVersion Int            @map("entity_version")
  /// Sanitized canonical DTO (null for deletes).
  payload       Json?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sequence])
  @@index([userId, entityType, entityId])
  @@map("sync_changes")
}

/// Idempotency receipt, written in the same transaction as the accepted mutation.
model SyncOperationReceipt {
  userId            String              @map("user_id")
  deviceId          String              @map("device_id") @db.Uuid
  clientOperationId String              @map("client_operation_id") @db.Uuid
  resultStatus      SyncOperationResult @map("result_status")
  resultPayload     Json                @map("result_payload")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Cascade)

  @@id([userId, deviceId, clientOperationId])
  @@map("sync_operation_receipts")
}

model UserSettings {
  userId        String    @id @map("user_id")
  schemaVersion Int       @default(1) @map("schema_version")
  /// Mirrors the client's explicit consent; never treated as consent by itself.
  syncEnabledAt DateTime? @map("sync_enabled_at") @db.Timestamptz(3)
  preferences   Json      @default("{}")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Security-relevant events only. Never store URL lists or tokens here.
model AuditEvent {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id")
  kind      AuditEventKind
  deviceId  String?        @map("device_id") @db.Uuid
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_events")
}

enum TabGroupColor {
  grey
  blue
  red
  yellow
  green
  pink
  purple
  cyan
  orange

  @@map("tab_group_color")
}

/// Same values as the contracts enum, with "_" in place of "-".
enum RestoreEligibility {
  restorable
  browser_internal
  local_file
  unsafe
  unsupported
  invalid

  @@map("restore_eligibility")
}

enum DevicePairingStatus {
  pending
  approved
  denied
  redeemed

  @@map("device_pairing_status")
}

enum SyncEntityType {
  workspace
  saved_session

  @@map("sync_entity_type")
}

enum SyncChangeKind {
  upsert
  delete

  @@map("sync_change_kind")
}

enum SyncOperationResult {
  accepted
  conflict
  rejected

  @@map("sync_operation_result")
}

enum AuditEventKind {
  sign_in
  device_paired
  device_revoked
  account_deletion_requested
  data_exported

  @@map("audit_event_kind")
}
